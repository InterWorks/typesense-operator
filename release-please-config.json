{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "typesense-operator",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "yaml",
          "path": "charts/typesense-operator/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "charts/typesense-operator/Chart.yaml",
          "jsonpath": "$.appVersion"
        },
        {
          "type": "yaml",
          "path": "charts/typesense-operator/values.yaml",
          "jsonpath": "$.controllerManager.manager.image.tag"
        },
        {
          "type": "generic",
          "path": "Makefile"
        }
      ]
    }
  }
}
